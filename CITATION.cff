version: 0.2.0
date-released: "2026-11-22"
license: MIT
repository-code: "https://github.com/OmniPotentRPC/lammpc"
keywords:
  - LAMMPS
  - C ABI
  - Cap'n Proto
  - molecular dynamics
  - Langevin dynamics
  - NVE dynamics
  - hard boundaries
